{
  "_type": "export",
  "__export_format": 4,
  "resources": [
    {
      "_id": "wrk_meme_manager",
      "name": "Meme Manager API",
      "description": "Collection complète pour le projet Meme Manager - R505/R506"
    },
    {
      "_id": "env_base",
      "name": "Base Environment",
      "data": {
        "base_url": "http://localhost:8055",
        "admin_token": "42a28c3d17d6d83727a7a1788ecba82de845b4853d92541bc6f75a7594649ce1",
        "user_token": ""
      }
    },
    {
      "_id": "req_auth_login",
      "name": "🔐 Login",
      "method": "POST",
      "url": "{{ base_url }}/auth/login",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
      }
    },
    {
      "_id": "req_auth_register",
      "name": "📝 Register",
      "method": "POST",
      "url": "{{ base_url }}/users",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"role\": \"d8c6ac86-38b4-4d60-ac34-467b3a757fc9\"\n}"
      }
    },
    {
      "_id": "req_memes_list",
      "name": "📋 Liste des memes",
      "method": "GET",
      "url": "{{ base_url }}/items/memes?fields=*,user_created.first_name,user_created.last_name,tags.tags_id.name&filter[status][_eq]=published&sort=-date_created",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ user_token }}"
        }
      ]
    },
    {
      "_id": "req_memes_create",
      "name": "➕ Créer un meme",
      "method": "POST",
      "url": "{{ base_url }}/items/memes",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ user_token }}"
        }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"title\": \"Mon super meme\",\n  \"image\": \"uuid-de-l-image\",\n  \"status\": \"published\"\n}"
      }
    },
    {
      "_id": "req_likes_toggle",
      "name": "❤️ Toggle Like",
      "method": "POST",
      "url": "{{ base_url }}/items/memes_likes",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ user_token }}"
        }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"meme_id\": 1,\n  \"user_id\": \"{{ $currentUserId }}\"\n}"
      }
    },
    {
      "_id": "req_notifications",
      "name": "🔔 Mes notifications",
      "method": "GET",
      "url": "{{ base_url }}/items/notifications?filter[user_id][_eq]=$CURRENT_USER&fields=*,from_user_id.first_name,from_user_id.avatar&sort=-date_created",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ user_token }}"
        }
      ]
    },
    {
      "_id": "req_search_meilisearch",
      "name": "🔍 Recherche Meilisearch",
      "method": "GET",
      "url": "{{ base_url }}/search?q=funny&collection=memes&limit=20",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ user_token }}"
        }
      ]
    },
    {
      "_id": "req_saved_memes",
      "name": "🔖 Memes enregistrés",
      "method": "GET",
      "url": "{{ base_url }}/items/saved_memes?filter[user_id][_eq]=$CURRENT_USER&fields=*,meme_id.*",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ user_token }}"
        }
      ]
    },
    {
      "_id": "req_oauth_github",
      "name": "🔐 OAuth GitHub",
      "method": "GET",
      "url": "{{ base_url }}/auth/login/github"
    }
  ]
}
