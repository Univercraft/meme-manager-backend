####################################################################################################
## Configuration générale Directus

PORT=8055
PUBLIC_URL=http://localhost:8055

####################################################################################################
## Base de données

DB_CLIENT=sqlite3
DB_FILENAME=./data/database.db

####################################################################################################
## Sécurité (⚠️ GÉNÉRER DES CLÉS ALÉATOIRES EN PRODUCTION)

KEY=remplacer-par-une-cle-aleatoire-de-32-caracteres
SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres

####################################################################################################
## Compte administrateur initial

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changez-moi-en-production

####################################################################################################
## OAuth GitHub (Optionnel)

# AUTH_PROVIDERS=github
# AUTH_GITHUB_DRIVER=oauth2
# AUTH_GITHUB_CLIENT_ID=your_github_client_id
# AUTH_GITHUB_CLIENT_SECRET=your_github_client_secret
# AUTH_GITHUB_SCOPE=read:user user:email
# AUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# AUTH_GITHUB_ACCESS_URL=https://github.com/login/oauth/access_token
# AUTH_GITHUB_PROFILE_URL=https://api.github.com/user
# AUTH_GITHUB_IDENTIFIER_KEY=id
# AUTH_GITHUB_EMAIL_KEY=email
# AUTH_GITHUB_FIRST_NAME_KEY=name
# AUTH_GITHUB_LAST_NAME_KEY=
# AUTH_GITHUB_AVATAR_KEY=avatar_url
# AUTH_GITHUB_REDIRECT_ALLOW_LIST=http://localhost:4200

####################################################################################################
## Meilisearch (Optionnel)

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-meilisearch-key-123
MEILISEARCH_INDEX_PREFIX=directus_
MEILISEARCH_BATCH_SIZE=100

####################################################################################################
## WebSockets

WEBSOCKETS_ENABLED=true
WEBSOCKETS_REST_AUTH=handshake
WEBSOCKETS_GRAPHQL_AUTH=handshake

####################################################################################################
## Extensions

EXTENSIONS_PATH=./extensions
EXTENSIONS_AUTO_RELOAD=true

####################################################################################################
## CORS

CORS_ENABLED=true
CORS_ORIGIN=http://localhost:4200
CORS_CREDENTIALS=true

####################################################################################################
## Rate Limiting (Production)

RATE_LIMITER_ENABLED=false
RATE_LIMITER_POINTS=25
RATE_LIMITER_DURATION=1

####################################################################################################
## Cache (Production)

CACHE_ENABLED=false
CACHE_TTL=10m
CACHE_NAMESPACE=directus-cache

####################################################################################################
## Email (Production - Optionnel)

# EMAIL_FROM=noreply@votredomaine.com
# EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your-email@example.com
# EMAIL_SMTP_PASSWORD=your-password
# EMAIL_SMTP_SECURE=false
